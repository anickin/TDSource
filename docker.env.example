# Portfolio deployment profile
TDS_DEPLOYMENT_MODE=portfolio
APP_ORIGIN=https://tdsource.nickolasinit.com
WEBEX_REDIRECT_URI=https://tdsource.nickolasinit.com/api/auth/webex/callback
APPROVED_EMAIL_DOMAINS=tdsynnex.com
SESSION_COOKIE_NAME=__Host-tds_session

# Generate these locally. Never commit docker.env.
SESSION_ENCRYPTION_KEY=replace-with-a-long-random-secret
SCHEDULER_SECRET=replace-with-a-different-long-random-secret

# Webex OAuth application (identity sign-in only; no bot token or webhook secret)
WEBEX_CLIENT_ID=replace-me
WEBEX_CLIENT_SECRET=replace-me

# Existing TDSource data store
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-me

# RAG answer generation
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_AI_API=replace-me

# Vector retrieval and background indexing
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
RAG_VECTOR_ENABLED=true
RAG_BACKFILL_ADMIN_EMAILS=
